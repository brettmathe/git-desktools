{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-desktools",
  "version": "0.3.0",
  "identifier": "com.brettmathe.gitdesktools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "git-desktools",
        "width": 1500,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "claude-plugin/.claude-plugin/plugin.json": "claude-plugin/.claude-plugin/plugin.json",
      "claude-plugin/scripts/smart_env.py": "claude-plugin/scripts/smart_env.py",
      "claude-plugin/skills/smart-environment/SKILL.md": "claude-plugin/skills/smart-environment/SKILL.md",
      "claude-plugin/skills/smart-environment-add-repo/SKILL.md": "claude-plugin/skills/smart-environment-add-repo/SKILL.md"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNkJENkVCNDU1NEI1MzcKUldRM3RWUkY2OVpyMCttOVFIbDIwa3JWMXp4WHZMVFN4S0h5MUFDaXErU05mSjVHcVJvTS9uOSsK",
      "endpoints": [
        "https://github.com/brettmathe/git-desktools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
